    array.push(evt_tips, "買了\n指標: 偏空 ▼ | 強度: ★★☆\nFB 07/09 12:25 反一買了就真的止跌了（笑）")
    array.push(evt_ticker, "")
    array.push(evt_time, 1783916179000)
