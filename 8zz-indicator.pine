    array.push(evt_tips, "虧損\n指標: 偏多 ▲ | 強度: ★★★\nFB 07/13 12:16 今天繼續蒸發30萬_(:_」∠)_ 反一的避險效益真的是搞笑  早上一度是多空都虧得狀態  不少我的持股明明指數不...")
    array.push(evt_ticker, "2303.TW")
    array.push(evt_time, 1783992006000)
